VerdantClientConfig: {
	DisplayName: Клиентская конфигурация

	EnableSteam: {
		Label: "[i:3365] Эффект пара"
		Tooltip: В подземном цветении поверх экрана будет виден эффект пара.
	}

	BackgroundObjects: {
		Label: "[i:933] Дополнительные декорации"
		Tooltip: На заднем фоне и перед экраном будут появляться разные декоративные объекты.
	}

	Waterfalls: {
		Label:  "[i:2169] Водопады из тайлов"
		Tooltip: Из некоторых тайлов, таких как плакучий бутон, будут вытекать водопады.
	}

	CustomDialogue: {
		Label: "[i:320] Новая система диалогов"
		Tooltip:
			'''
			Апофеоз будет использовать собственную, уникальную систему диалогов.
			Если отключить, Апофеоз будет просто отправлять сообщения в чат.
			'''
	}

	JungleSpawn: {
		Label: "[i:620] Генерировать биом в джунглях"
		Tooltip:
			'''
			Цветение всегда будет генерироваться в джунглях.
			Включите, цветение перекрывает вам биомы/структуры из других модов.
			Не работает, если настройка «Генерировать биом в центре мира» включена
			'''
	}

	DialogueSpeed: {
		Label: "[i:4485] Скорость диалогов"
		Tooltip: Устанавливает скорость вывода фраз Апофеоза на экране.
	}

	CenterSpawn: {
		Label: "[i:9] Генерировать биом в центре мира"
		Tooltip:
			'''
			Цветение всегда будет генерироваться в центре мира.
			Это может привести к тому, что биом будет пересекаться с пустыней и тундрой.
			'''
	}
}
