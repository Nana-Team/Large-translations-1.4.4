CranberryJelly: {
	DisplayName: Брусничное варенье
	Tooltip:
		'''
		Автоматически используется, когда ваше здоровье опускается ниже 50%
		Вызываемая послезельевая болезнь будет в 2 раза короче обычного
		'''
}

CranberryJuice: {
	DisplayName: Брусничный сок
	Tooltip: "{$Items.CranberryJelly.Tooltip}"
}

Brick: {
	DisplayName: Тяжёлый кирпич
	Tooltip:
		'''
		Можно бросить в кого-нибудь спящего, чтобы разбудить его
		Пробуждает Нарцисс, если попасть по ней
		'''
}

Concoction: {
	DisplayName: Кислотный отвар
	Tooltip:
		'''
		Не расходуется
		Крайне едкая жидкость, изготовленная из самых мерзких ингредиентов
		Вылейте на огромное яйцо из глазастой долины, чтобы растворить его барьер
		'''
