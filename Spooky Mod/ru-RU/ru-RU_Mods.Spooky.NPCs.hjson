RotGourd: {
	DisplayName: Тухлая тыква

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/RottenSeed] в жутком лесу. Семя можно получить при разрушении заплесневевших тыкв в этом же биоме.
		DespawnMessage: Тухлая тыква надавала всем в тыкву...
	}
}

SpookySpirit: {
	DisplayName: Пугающий призрак

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/EMFReader] рядом с проклятой статуей ночью на заболоченном кладбище.
		DespawnMessage: Пугающий призрак досмерти запугал всех охотников за приведениями...
	}
}

Moco: {
	DisplayName: Моко

	BossChecklistIntegration: {
		SpawnInfo: Нажмите ПКМ по святилищу носового бога в глазастой долине, держа [i:Spooky/CottonSwab] в своём инвентаре.
		DespawnMessage: Моко улетает с поднятым носом...
	}
}

DaffodilEye: {
	DisplayName: Нарцисс

	BossChecklistIntegration: {
		SpawnInfo: Бросьте в неё [i:Spooky/Brick], чтобы разбудить.
		DespawnMessage: Нарцисс затмила всех своим нарциссизмом...
	}
}

OldHunterBoss: {
	DisplayName: Старый охотник

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/OldHunterSoul] рядом с трупом Старого охотника.
		DespawnMessage: Старый охотник успешно тряхнул стариной...
	}
}

OrroHead: {
	DisplayName: Урро

	BossChecklistIntegration: {
		EntryName: Урро и Боро
		SpawnInfo: Используйте [i:Spooky/Concoction] на огромном яйце в глазастой долине после победы над Яичным вторжением.
		DespawnMessage: Урро и Боро
	}
}

BigBone: {
	DisplayName: Черепище

	BossChecklistIntegration: {
		SpawnInfo: Используйте [i:Spooky/Fertilizer] рядом с гигантским цветочным горшком на дне Катакомб.
		DespawnMessage: Everyone has met their blooming doom by big bone
	}
}

SpookFishron: {
	DisplayName: Герцог Испугрон

	BossChecklistIntegration: {
		SpawnInfo: Fish in the ocean at night during a pumpkin moon while using a [i:Spooky/SinisterSnailItem] as bait. Sinister snails spawn in the underground spooky forest in hardmode.
		DespawnMessage: Every player has been turned into bad sushi
	}
}

