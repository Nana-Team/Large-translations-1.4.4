SpookyConfig: {
	DisplayName: Spooky Mod Client Config

	ScreenShakeIntensity: {
		Label: Screen Shake Intensity Multiplier
		Tooltip:
			'''
			Adjust the intensity of the screen shaking effect caused by various things in the mod
			The default value for this setting is 1, which is the normal screen shaking intensity
			Anything higher than the normal intensity will make the screen shaking more intense
			Anything lower than the normal intensity will make the screen shaking less intense
			Turning this all the way down will entirely disable the mod's screen shake effect
			'''
	}

	DraggableUI: {
		Label: Draggable UIs
		Tooltip:
			'''
			Toggle for certain spooky mod UIs being moveable by holding left click and dragging them elsewhere
			Enabling this will allow you to drag them, and disabling this will lock them in place wherever they are
			Note: this does not apply to all UIs added by spooky mod, just ones relating to player things
			(Such as the bloom buffs UI, various accessory UIs, and such)
			'''
	}

	DialogueSpeed: {
		Label: Dialogue Fill-In Speed
		Tooltip:
			'''
			Changes the speed at which spooky mod special NPC dialogue fills in
			Can be changed between Normal, Fast, and Instant
			'''
	}

	DialogueFocus: {
		Label: Dialogue Focuses On Talking NPC
		Tooltip:
			'''
			Toggle for spooky mod's special dialogue panning your camera on the NPC you are talking to
			Enabling this will pan you camera to the NPC, and disabling this will not pan your camera to the NPC
			'''
	}
}

SpookyServerConfig: {
	DisplayName: Spooky Mod Server Config

	HalloweenEnabled: {
		Label: Halloween Season
		Tooltip:
			'''
			Spooky mod, by default, makes terraria's halloween seasonal event always active as a quality of life feature
			Keeping this option allows the halloween seasonal content to always be active
			Keeping this option off will just make the halloween seasonal event only occur when it normally should
			(Like during the month of October, or when you make it to wave 15 of the pumpkin moon before daytime)
			'''
	}

	NoseTempleMaxPlayers: {
		Label: Moco Temple Ambushes Require All Players
		Tooltip:
			'''
			Allows you to force all players who are in the nose temple into any combat room if any player activates it
			If turned on, then every single player inside the nose temple will be instantly teleported into the room
			If turned off, then the combat rooms will work normally and won't account for other players
			'''
	}
}

SpookyWorldgenConfig: {
	DisplayName: Spooky World Generation Config

	SpookyForestSpawn: {
		Label: Spooky Forest Spawnpoint
		Tooltip:
			'''
			Changes the location of where the spooky forest is placed during world generation
			Keeping this on will make it placed at your spawn, which is the default option
			Turning this off will make the spooky forest generate away from your spawn, on the dungeon side of the world
			This can be helpful if you are using other mods that add world generation at or nearby spawn
			(This option is only applied when making new worlds, and will have no effect on existing worlds)
			'''
	}

	EyeValleyWorldSide: {
		Label: Eye Valley World Side
		Tooltip:
			'''
			Allows you to determine which side of the world the eye valley will generate on
			"Random" will randomize it being on the left or right edge of the world
			"Jungle side" will make the eye valley always generate on the same side of the world that the jungle is on
			"Dungeon side" will make the eye valley always generate on the same side of the world that the dungeon is on
			Can be helpful if you are using other mods that add world generation in the underworld
			(This option is only applied when making new worlds, and will have no effect on existing worlds)
			'''
	}

	ZombieBiomeWorldside: {
		Label: Rotten Depths World Side
		Tooltip:
			'''
			Allows you to determine which side of the world the rotten depths will generate on
			"Random" will randomize it being on the left or right ocean in the world
			"Jungle side" will make the rotten depths always generate on the same side of the world that the jungle is on
			"Dungeon side" will make the rotten depths always generate on the same side of the world that the dungeon is on
			Can be helpful if you are using other mods that add in biomes under the oceans
			[c/FF1D00:WARNING!] If you have either calamity or thorium enabled, this config option will be disregarded
			If you have just calamity, the rotten depths will generate on the jungle side (Opposite of sulphur sea)
			If you have just thorium, the rotten depths will generate on the dungeon side (Opposite of aquatic depths)
			If you have both calamity and thorium, the rotten depths will generate next to the sulphur sea biome
			(This option is only applied when making new worlds, and will have no effect on existing worlds)
			'''
	}
}

